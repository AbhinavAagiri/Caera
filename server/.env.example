# CAERA local node configuration
# Copy this file to server/.env and edit it there. The Express node reads this
# file only; it is never bundled into the browser client.
#
# CAERA binds to loopback and rejects requests from other origins. Never commit
# the real .env file, keys or private paths.

# --- Network ---------------------------------------------------------------
# Only 127.0.0.1, ::1 or localhost are accepted. The node refuses to bind to a
# public interface.
CAERA_HOST=127.0.0.1
CAERA_PORT=5174

# Browser origins allowed to call the local API. Loopback only. The node's own
# origin is always allowed in addition to these.
# CAERA_CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Storage ---------------------------------------------------------------
# SQLite lives here as caera.db (plus WAL sidecars). Default: server/.data
# CAERA_DATA_DIR=D:\CAERA\data

# --- Request limits --------------------------------------------------------
# CAERA_REQUEST_TIMEOUT_MS=20000
# CAERA_HEADERS_TIMEOUT_MS=10000
# CAERA_KEEP_ALIVE_TIMEOUT_MS=5000
# CAERA_MESSAGE_MAX_CHARS=8000

# --- Model providers -------------------------------------------------------
# All credentials are used only by the local node. The browser never receives
# them. You can also save provider credentials in Settings → Models & usage:
# Gemini is stored in server/.data/provider.json; the other hosted providers in
# server/.data/ai-providers.json. A saved key takes precedence over the matching
# environment value. Keys are never returned by /api/health or any API response.
#
# Only configured providers are eligible; there is no implicit fallback to a
# provider whose key is unset. All five adapters stream.
GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# Ollama needs no key and must stay on loopback.
# OLLAMA_URL=http://127.0.0.1:11434

# Default Gemini model id. OpenAI, Anthropic, DeepSeek and Ollama model choices
# are configured in Settings → Models & usage.
CAERA_MODEL=gemini-3.8-flash

# Longest time one routed reply may take, in milliseconds. A timer aborts the
# generation and keeps any partial text.
# CAERA_PROVIDER_TIMEOUT_MS=120000

# Output and conversation-context limits sent to the selected provider.
# CAERA_MAX_OUTPUT_TOKENS=8192
# CAERA_CONTEXT_MESSAGES=40
# CAERA_CONTEXT_CHARS=60000

# Optional full system-instruction override. Leave unset to use the built-in
# CAERA personality and honesty rules. You can also edit this in Settings.
# CAERA_SYSTEM_INSTRUCTION=

# --- Agent -----------------------------------------------------------------
# The controlled agent uses whichever provider/model the router selects. There
# are no agent-specific environment variables in this build. Its fixed safety
# bounds are:
#   5 plan steps, 8 tool calls, 3 decision rounds per step, 180s active run,
#   45s per model call and 20s per tool. Writes and deletes always require
#   exact-action approval. The agent has no shell or arbitrary code tool.
# No suitable configured model makes a start request fail with an explicit
# setup error rather than inventing a plan or activity.

# --- VoiceStudio -----------------------------------------------------------
# VoiceStudio is a separate local speech engine
# (https://github.com/debpalash/VoiceStudio) that CAERA talks to over its
# loopback API. CAERA can start its documented headless backend; it never opens
# the desktop GUI or bundles its installer or model weights.
#
# These environment values are defaults. The address, enabled switch, voice,
# speed, format, auto-speak, startup mode and source-folder settings saved in
# Settings → Voice take precedence and live in server/.data/voice.json.
#
# Loopback only: localhost, 127.0.0.1 or ::1. Never expose port 3900 publicly.
# VOICESTUDIO_ENABLED=false
# VOICESTUDIO_URL=http://localhost:3900
#
# Maximum time one speech request may take, in milliseconds (5s–300s).
# Health, OpenAPI discovery and voice-list requests use shorter fixed limits.
# VOICESTUDIO_TIMEOUT_MS=120000
#
# Maximum time one push-to-talk transcription may take. VoiceStudio must have
# an ASR model installed; CAERA surfaces a clear error when it does not.
# VOICESTUDIO_TRANSCRIBE_TIMEOUT_MS=90000
#
# Lifecycle defaults. "startup" starts the headless service during node boot;
# "on-demand" waits until speech output or push-to-talk needs it.
# VOICESTUDIO_AUTO_START=true
# VOICESTUDIO_START_MODE=startup
#
# A prepared VoiceStudio source checkout (the documented "bun run dev:api"
# launcher). It must already contain the checkout and its .venv.
# VOICESTUDIO_DIR=D:\VoiceStudio
#
# Advanced: another documented headless launcher. Use a JSON argv array to
# avoid quoting ambiguity; a plain whitespace-separated command also works.
# The command must run in the foreground and is never passed through a shell.
# VOICESTUDIO_LAUNCH_CMD=["docker","run","--rm","-p","127.0.0.1:3900:3900","<voicestudio-image>"]
# VOICESTUDIO_LAUNCH_CWD=D:\VoiceStudio
#
# Readiness budget and stop budget in milliseconds. Health polling continues
# until this deadline; a failed start is surfaced in Settings and Activity.
# VOICESTUDIO_START_TIMEOUT_MS=120000
# VOICESTUDIO_STOP_TIMEOUT_MS=5000

# --- Connectors ------------------------------------------------------------
# Connector management and all connector adapters are enabled by default.
# Set this to false to disable connections and connector tool execution while
# keeping existing grants in SQLite. Restart the node after changing it.
# CAERA_CONNECTORS_ENABLED=true
#
# Application credentials are NOT environment variables. Enter them through
# Connections; the node stores them in local SQLite (server-only secret_json):
#   Notion  -> internal integration token (official HTTPS API)
#   Logseq  -> HTTP APIs server token (loopback only)
#   Anytype -> local API key and space ID (loopback only)
# They are never returned to the browser and never written to .env.
#
# Optional default Obsidian vault. The Connections page can choose the same
# folder; a path saved there takes precedence. The saved connection also owns
# accessible/excluded folders, the default note folder, note naming and the
# trusted-creation flag. Only Markdown notes inside the approved folders are
# reachable; reserved folders and symlink escapes are rejected.
# CAERA_OBSIDIAN_VAULT=D:\Notes\Vault
#
# Notion, Logseq and Anytype have no environment defaults for credentials.
# Their endpoints, expected graph/space and default type are saved per
# connection in Connections. Local endpoints must be loopback addresses.

# Reserved. The local computer layer does not read this list in this build;
# approve folders explicitly in Tools → Local computer. The Obsidian connector
# is contained to its own connected vault.
# CAERA_APPROVED_DIRS=D:\CAERA\workspace,D:\Notes
